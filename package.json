{
  "name": "foundation-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Qualification instrument for the Claude Engineering Foundation. Not a customer product.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node src/spine/main.ts",
    "test": "node --test \"tests/**/*.test.ts\"",
    "test:unit": "node --test \"tests/unit/*.test.ts\"",
    "test:contract": "node --test \"tests/contract/*.test.ts\"",
    "test:integration": "node --test \"tests/integration/*.test.ts\"",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/api-logs": "^0.221.0",
    "@opentelemetry/exporter-logs-otlp-http": "^0.221.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
    "@opentelemetry/resources": "^2.1.0",
    "@opentelemetry/sdk-logs": "^0.221.0",
    "@opentelemetry/sdk-node": "^0.221.0",
    "@opentelemetry/semantic-conventions": "^1.37.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.2.0",
    "typescript": "^7.0.2"
  }
}
