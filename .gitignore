# Both forms: the trailing-slash pattern does NOT match a SYMLINK named node_modules, which
# is how worktrees share one install — and how an absolute-path symlink was briefly
# committed. A symlink to /Users/... would break on any other machine.
node_modules
node_modules/
data/
*.sqlite
*.sqlite-journal

# Local secret material never belongs in this repo — references only (SPEC §7).
.env
.env.*

# Routine generated proof belongs in artifact storage, not Git (Standard 4).
artifacts/
test-results/
playwright-report/

# Generated locally by scripts/write-mcp-config.ts. Holds LOCAL credential VALUES,
# and the repository stores references rather than values (SPEC §7).
foundation-lab-mcp.json
